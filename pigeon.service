# Copy to /etc/systemd/system/pigeon.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=PIGEON UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/Pigeon
ExecStart=/home/YOURUSER/Pigeon/venv/bin/uvicorn app:app --port 7000 --host 0.0.0.0
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/Pigeon/.env

[Install]
WantedBy=multi-user.target
